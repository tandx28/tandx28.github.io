---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Palette from '../components/Palette.astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD for this page, e.g. a project's SoftwareApplication. */
  schema?: Record<string, unknown>;
}

const {
  title = `${profile.name} | Software Engineer, NUS Computer Science`,
  description = profile.blurb,
  schema,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f7f5f0" />
    <meta name="author" content={profile.name} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Fonts load without blocking the first paint; system fonts show until they arrive. -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" /></noscript>
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:site_name" content={`${profile.name} portfolio`} />
    <meta property="og:locale" content="en_SG" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, software engineer`} />
    <link rel="sitemap" href="/sitemap.xml" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': new URL('/#person', Astro.site).href,
          name: profile.name,
          alternateName: ['De Xun Tan', 'Tan Dexun', profile.handle],
          url: Astro.site?.toString(),
          image: ogImage.href,
          email: `mailto:${profile.email}`,
          jobTitle: 'Software Engineer (student)',
          address: { '@type': 'PostalAddress', addressCountry: 'SG', addressLocality: 'Singapore' },
          affiliation: { '@type': 'CollegeOrUniversity', name: 'National University of Singapore' },
          alumniOf: { '@type': 'CollegeOrUniversity', name: 'Singapore Polytechnic' },
          knowsAbout: ['Software engineering', 'AI-assisted development', 'AI agents', 'Prompt engineering', 'TypeScript', 'Angular', '.NET', 'Cloud computing', 'Cybersecurity'],
          sameAs: [profile.github, profile.linkedin],
        },
        {
          '@type': 'WebSite',
          '@id': new URL('/#website', Astro.site).href,
          url: Astro.site?.toString(),
          name: `${profile.name} portfolio`,
          author: { '@id': new URL('/#person', Astro.site).href },
        },
        ...(schema ? [schema] : []),
      ],
    })} />

    <!-- Runs before paint so a stored theme never flashes the wrong colours. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
        } catch (e) {}
      })();
      document.addEventListener('astro:after-swap', function () {
        document.documentElement.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      });
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Palette />
    <script>
      import { boot } from '../scripts/fx';
      document.addEventListener('astro:page-load', boot);
    </script>
  </body>
</html>

