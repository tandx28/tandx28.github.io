---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const all = (await getCollection('projects'))
    .filter((p) => p.data.tier === 'featured')
    .sort((a, b) => a.data.order - b.data.order);
  return all.map((p, i) => ({ params: { id: p.id }, props: { p, next: all[(i + 1) % all.length] } }));
}

const { p, next } = Astro.props;
const { Content } = await render(p);
const d = p.data;
---

<Base
  title={`${d.title} | Tan De Xun`}
  description={d.tagline}
  schema={{
    '@type': d.live ? 'SoftwareApplication' : 'CreativeWork',
    name: d.title,
    description: d.tagline,
    ...(d.live ? { url: d.live, applicationCategory: p.id === 'gatebound' ? 'GameApplication' : 'FinanceApplication', operatingSystem: 'Web browser', offers: { '@type': 'Offer', price: '0', priceCurrency: 'SGD' } } : {}),
    ...(d.repo ? { codeRepository: d.repo } : {}),
    author: { '@id': new URL('/#person', Astro.site).href },
    keywords: d.stack.join(', '),
  }}
>
  <article style={`--acc:${d.accent}`}>
    <header class="container head">
      <a href="/#work" class="back">← All work</a>
      <p class="meta" data-reveal>{d.year}{d.role ? ` · ${d.role}` : ''}</p>
      <h1 transition:name={`title-${p.id}`}>{d.title}</h1>
      <p class="tag" data-reveal style="--i:1">{d.tagline}</p>
      <div class="ctas" data-reveal style="--i:2">
        {d.live && <a class="btn primary" href={d.live} target="_blank" rel="noopener">Open live <span class="arrow">↗</span></a>}
        {d.repo && <a class="btn" href={d.repo} target="_blank" rel="noopener">Source code <span class="arrow">↗</span></a>}
        {!d.live && !d.repo && <span class="tag">{d.status === 'private' ? 'code is private' : 'not public yet'}</span>}
      </div>
      {d.stats.length > 0 && (
        <ul class="stats">
          {d.stats.map((s, i) => (
            <li data-reveal style={`--i:${i}`}><span class="v">{s.value}</span><span class="l">{s.label}</span></li>
          ))}
        </ul>
      )}
    </header>
    {d.cover && (
      <div class="container" data-reveal>
        <a class="shot" href={d.live} target="_blank" rel="noopener"><Image src={d.cover} alt={`Screenshot of ${d.title}`} widths={[640, 1000, 1280]} sizes="(max-width: 1160px) 92vw, 1080px" format="webp" quality={78} loading="eager" class="shot-img" /></a>
      </div>
    )}
    <div class="container body">
      <aside data-reveal>
        <p class="k">Stack</p>
        <ul>{d.stack.map((s) => <li class="tag">{s}</li>)}</ul>
        <p class="k">Status</p>
        <p class="v2">{d.status}</p>
      </aside>
      <div class="prose" data-reveal style="--i:1"><Content /></div>
    </div>
    <nav class="container next">
      <a href={`/projects/${next.id}/`}>
        <span>Next project →</span>
        <strong>{next.data.title}</strong>
      </a>
    </nav>
  </article>
</Base>

<style>
  .head {
    padding-top: 140px;
    padding-bottom: 40px;
  }
  .back {
    display: inline-block;
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 40px;
    transition: color 0.2s, transform 0.3s var(--ease);
  }
  .back:hover {
    color: var(--acc);
    transform: translateX(-4px);
  }
  .meta {
    color: var(--acc);
    font-size: 13px;
    margin: 0 0 12px;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(48px, 8vw, 96px);
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0 0 24px;
  }
  .tag {
    font-size: clamp(19px, 2vw, 24px);
    color: var(--muted);
    max-width: 50ch;
    margin: 0 0 32px;
  }
  .ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .stats {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    border-top: 1px solid var(--line);
  }
  .stats li {
    padding: 24px 20px 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .v {
    font-family: var(--font-serif);
    font-size: clamp(36px, 4vw, 52px);
    line-height: 1;
    color: var(--text);
  }
  .l {
    color: var(--muted);
    font-size: 14px;
  }
  .shot {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow);
    margin-top: 20px;
  }
  .shot :global(.shot-img) {
    width: 100%;
    height: auto;
    transition: transform 1.2s var(--ease);
  }
  .shot:hover :global(.shot-img) {
    transform: scale(1.02);
  }
  .body {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 56px;
    padding-top: 40px;
    padding-bottom: 80px;
  }
  aside {
    position: sticky;
    top: 100px;
    align-self: start;
  }
  aside ul {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .k {
    font-size: 12px;
    color: var(--faint);
    margin: 0 0 10px;
  }
  .v2 {
    margin: 0;
    text-transform: capitalize;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .next {
    padding-bottom: 100px;
  }
  .next a {
    --mx: 50%;
    --my: 50%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding: 32px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--surface);
    transition: border-color 0.3s;
  }
  .next a:hover {
    border-color: var(--acc);
  }
  .next span {
    color: var(--muted);
    font-size: 13px;
  }
  .next strong {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(26px, 3vw, 38px);
  }
  @media (max-width: 800px) {
    .body {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    aside {
      position: static;
    }
  }
</style>
