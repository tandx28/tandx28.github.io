---
import { journey } from '../data/profile';
---

<section id="journey">
  <div class="container">
    <p class="eyebrow" data-reveal>05 / journey</p>
    <h2 class="h2" data-reveal data-scramble-on-view>Where I've <span class="grad">learned the craft.</span></h2>
    <ol class="line" data-timeline>
      <span class="rail" aria-hidden="true"><span class="fill"></span></span>
      {journey.map((j, i) => (
        <li data-reveal style={`--i:${i}`}>
          <span class="node" aria-hidden="true"></span>
          <p class="when mono">{j.when}</p>
          <div class="card">
            <h3>{j.what}</h3>
            <p class="where">{j.where}</p>
            <ul>
              {j.notes.map((n) => <li>{n}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .line {
    position: relative;
    list-style: none;
    margin: 56px 0 0;
    padding: 0 0 0 40px;
  }
  .rail {
    position: absolute;
    left: 7px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background: var(--line);
    border-radius: 2px;
  }
  .fill {
    position: absolute;
    inset: 0;
    transform-origin: top;
    transform: scaleY(var(--tl, 0));
    background: linear-gradient(var(--accent), var(--accent-2));
    border-radius: inherit;
  }
  .line > li {
    position: relative;
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 24px;
    padding-bottom: 40px;
  }
  .node {
    position: absolute;
    left: -40px;
    top: 4px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: var(--bg);
    box-shadow: 0 0 0 5px var(--glow);
  }
  .when {
    margin: 0;
    font-size: 13px;
    color: var(--accent);
    padding-top: 2px;
  }
  .card {
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.3s, transform 0.5s var(--ease);
  }
  .card:hover {
    border-color: var(--line-strong);
    transform: translateX(4px);
  }
  h3 {
    margin: 0;
    font-size: 21px;
    letter-spacing: -0.02em;
  }
  .where {
    margin: 4px 0 12px;
    color: var(--muted);
  }
  ul {
    margin: 0;
    padding-left: 18px;
    color: var(--muted);
    font-size: 15px;
  }
  ul li {
    margin: 6px 0;
  }
  ul li::marker {
    color: var(--accent);
  }
  @media (max-width: 720px) {
    .line > li {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
