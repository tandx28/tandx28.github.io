---
import { Image } from 'astro:assets';
import { press } from '../data/profile';
import gdg from '../assets/photos/gdg-nus.jpg';
---

<section id="press">
  <div class="container">
    <div class="sec-head">
      <p class="label">Press and community</p>
      <div>
        <h2 class="h2">Out in the world.</h2>
      </div>
    </div>

    <div class="cols">
      <div class="articles">
        {press.map((a) => (
          <a class="article" href={a.url} target="_blank" rel="noopener" data-reveal>
            <p class="meta">{a.outlet} · {a.date}</p>
            <h3>{a.title} <span aria-hidden="true">↗</span></h3>
            <p>{a.note}</p>
          </a>
        ))}
      </div>
      <figure data-reveal style="--i:1">
        <Image src={gdg} alt="Members of Google Developer Group at NUS Computing posing in front of the group's logo" widths={[640, 1000, 1400]} sizes="(max-width: 860px) 92vw, 620px" format="webp" quality={75} class="photo" />
        <figcaption>With Google Developer Group @ NUS Computing, where I'm a Tech Associate.</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 40px;
    align-items: start;
  }
  .article {
    display: block;
    text-decoration: none;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .article:last-child {
    border-bottom: 1px solid var(--line);
  }
  .meta {
    margin: 0 0 4px;
    font-size: 13px;
    color: var(--faint);
  }
  h3 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 26px;
    line-height: 1.15;
    margin: 0 0 8px;
  }
  h3 span {
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--faint);
  }
  .article:hover h3 {
    color: var(--accent);
  }
  .article p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  figure {
    margin: 0;
  }
  figure :global(.photo) {
    width: 100%;
    border-radius: 8px;
  }
  figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--faint);
  }
  @media (max-width: 860px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
