---
import { profile } from '../data/profile';
---

<section id="contact">
  <div class="container">
    <div class="sec-head">
      <p class="label">Contact</p>
      <div>
        <h2 class="h2">Say hello.</h2>
        <p class="lede">
          Hiring for Summer 2027, running a scholarship panel, or want to compare notes on building with AI? Email is the
          fastest way to reach me.
        </p>
        <p class="mail">
          <a class="link" href={`mailto:${profile.email}`}>{profile.email}</a>
          <button class="copy" type="button" data-copy-email data-email={profile.email}>Copy</button>
        </p>
        <p class="links">
          <a class="link" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a class="link" href={profile.github} target="_blank" rel="noopener">GitHub</a>
          <a class="link" href={profile.resume} target="_blank" rel="noopener">Résumé (PDF)</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin: 28px 0 14px;
    font-family: var(--font-serif);
    font-size: clamp(26px, 4vw, 40px);
    overflow-wrap: anywhere;
  }
  .copy {
    font: 13px var(--font-sans);
    padding: 5px 10px;
    border-radius: 6px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
  }
  .copy:hover {
    color: var(--text);
    border-color: var(--text);
  }
  .links {
    display: flex;
    gap: 22px;
    margin: 0;
  }
</style>
