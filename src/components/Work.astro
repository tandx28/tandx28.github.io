---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.tier === 'featured');
const small = all.filter((p) => p.data.tier === 'small');
const statusLabel = { live: 'Live', 'in progress': 'In progress', private: 'Private code' } as const;
---

<section id="work">
  <div class="container">
    <div class="sec-head">
      <p class="label">Selected work</p>
      <div>
        <h2 class="h2">Things I've built.</h2>
        <p class="lede">Each one has a short write-up: the problem, what I built and what I'd do differently.</p>
      </div>
    </div>

    <ul class="list">
      {featured.map((p) => (
        <li data-reveal>
          <a href={`/projects/${p.id}/`} class="row">
            <div class="thumb">
              {p.data.cover ? (
                <Image src={p.data.cover} alt="" widths={[360, 640]} sizes="(max-width: 860px) 92vw, 300px" format="webp" quality={70} class="thumb-img" />
              ) : (
                <span class="initial">{p.data.title.slice(0, 1)}</span>
              )}
            </div>
            <div class="txt">
              <p class="meta">
                {p.data.year}{p.data.role ? ` · ${p.data.role}` : ''} · <span class={`st s-${p.data.status.replace(' ', '-')}`}>{statusLabel[p.data.status]}</span>
              </p>
              <h3>{p.data.title}</h3>
              <p class="tagline">{p.data.tagline}</p>
              <p class="stack">{p.data.stack.slice(0, 5).map((s) => <span class="tag">{s}</span>)}</p>
            </div>
            <span class="go" aria-hidden="true">Read →</span>
          </a>
        </li>
      ))}
    </ul>

    <h3 class="more">Also</h3>
    <ul class="small">
      {small.map((p) => (
        <li>
          <span class="t">{p.data.title}</span>
          <span class="d">{p.data.tagline}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 220px 1fr auto;
    gap: 28px;
    align-items: start;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .thumb {
    aspect-ratio: 16 / 10;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg-2);
    display: grid;
    place-items: center;
  }
  .thumb :global(.thumb-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .initial {
    font-family: var(--font-serif);
    font-size: 64px;
    color: var(--faint);
  }
  .meta {
    margin: 0 0 2px;
    font-size: 13px;
    color: var(--faint);
  }
  .s-live {
    color: #1d7a3e;
  }
  :global(:root[data-theme='dark']) .s-live {
    color: #7fd39b;
  }
  h3 {
    margin: 0 0 6px;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.1;
  }
  .row:hover h3 {
    color: var(--accent);
  }
  .tagline {
    margin: 0 0 12px;
    color: var(--muted);
    max-width: 60ch;
  }
  .stack {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .go {
    font-size: 14px;
    color: var(--faint);
    padding-top: 26px;
    white-space: nowrap;
  }
  .row:hover .go {
    color: var(--accent);
  }
  .more {
    margin: 44px 0 8px;
    font-size: 13px;
    font-weight: 400;
    color: var(--faint);
  }
  .small {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .small li {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 28px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    font-size: 15px;
  }
  .t {
    font-weight: 600;
  }
  .d {
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .row {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .go {
      display: none;
    }
    .small li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
