---
import { stack } from '../data/profile';
const flat = stack.flatMap((g) => g.items);
---

<section id="stack">
  <div class="marquee" aria-hidden="true">
    <div class="track mono">
      {[...flat, ...flat].map((s) => <span>{s}<i>✦</i></span>)}
    </div>
  </div>
  <div class="container">
    <p class="eyebrow" data-reveal>06 / stack</p>
    <h2 class="h2" data-reveal data-scramble-on-view>Tools I <span class="grad">reach for.</span></h2>
    <div class="grid">
      {stack.map((g, i) => (
        <div class="group" data-reveal data-spotlight style={`--i:${i}`}>
          <p class="g mono">{`{ ${g.group} }`}</p>
          <ul>
            {g.items.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding: 18px 0;
    margin-bottom: clamp(60px, 9vw, 110px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    gap: 0;
    animation: slide 45s linear infinite;
    font-size: clamp(18px, 2.4vw, 28px);
    color: var(--muted);
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  .track span {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    white-space: nowrap;
  }
  .track i {
    font-style: normal;
    color: var(--accent);
    font-size: 0.6em;
  }
  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }
  #stack {
    padding-top: 0;
  }
  .grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
  }
  .group {
    --mx: 50%;
    --my: 50%;
    position: relative;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      radial-gradient(260px circle at var(--mx) var(--my), var(--glow), transparent 60%),
      var(--surface);
  }
  .g {
    margin: 0 0 14px;
    font-size: 13px;
    color: var(--accent);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 7px;
  }
  li {
    font-size: 15px;
  }
</style>
