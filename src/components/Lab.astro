---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Games and films built mainly by directing AI. Each one is a single page
// hosted as-is under public/lab/.
const lab = (await getCollection('projects'))
  .filter((p) => p.data.tier === 'lab')
  .sort((a, b) => a.data.order - b.data.order);

---

<section id="lab">
  <div class="container">
    <p class="eyebrow" data-reveal>04 / lab</p>
    <h2 class="h2" data-reveal data-scramble-on-view>Learning new tech <span class="grad">by shipping it.</span></h2>
    <p class="lede" data-reveal style="--i:1">
      When I want to learn something new, I build a small, finished thing with it. These experiments, made while exploring
      AI pair programming, taught me 3D graphics, pathfinding and frame-by-frame animation in the browser. They all run here.
    </p>


    <div class="grid">
      {lab.map((p, i) => (
        <a class="tile" href={p.data.play} target="_blank" rel="noopener" data-reveal data-spotlight data-tilt style={`--i:${i % 2};--acc:${p.data.accent}`}>
          <div class="shot">
            {p.data.cover && <Image src={p.data.cover} alt={`Screenshot of ${p.data.title}`} widths={[480, 800]} sizes="(max-width: 860px) 92vw, 560px" format="webp" quality={72} class="shot-img" />}
            <span class="kind mono">{p.data.kind === 'film' ? '▶ stop-motion film' : '◆ playable game'}</span>
          </div>
          <div class="txt">
            <h3>{p.data.title}</h3>
            <p>{p.data.tagline}</p>
            <div class="foot mono">
              <span>{p.data.stack.slice(0, 3).join(' · ')}</span>
              <span class="go">{p.data.kind === 'film' ? 'watch ↗' : 'play ↗'}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
    <p class="note mono" data-reveal>// games need a keyboard and mouse; films work everywhere</p>
  </div>
</section>

<style>
  .loop {
    list-style: none;
    padding: 0;
    margin: 44px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .loop li {
    background: var(--bg);
    padding: 18px 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: relative;
  }
  .loop li:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: 10px;
    top: 16px;
    color: var(--accent);
    opacity: 0.6;
  }
  .n {
    font-size: 11px;
    color: var(--faint);
  }
  .loop b {
    font-size: 15px;
    color: var(--accent);
    font-weight: 500;
  }
  .d {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--muted);
  }
  .grid {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .tile {
    --mx: 50%;
    --my: 50%;
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    border: 1px solid var(--line);
    background:
      radial-gradient(420px circle at var(--mx) var(--my), color-mix(in srgb, var(--acc) 12%, transparent), transparent 50%),
      var(--surface);
    overflow: hidden;
    transform-style: preserve-3d;
    transition: transform 0.6s var(--ease), border-color 0.3s;
  }
  .tile:hover {
    border-color: color-mix(in srgb, var(--acc) 60%, transparent);
  }
  .shot {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--bg-2);
  }
  .shot :global(.shot-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 1.2s var(--ease), filter 0.6s;
    filter: saturate(0.85);
  }
  .tile:hover :global(.shot-img) {
    transform: scale(1.05);
    filter: saturate(1.05);
  }
  .kind {
    position: absolute;
    left: 14px;
    bottom: 14px;
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 11px;
    color: #fff;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .txt {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  h3 {
    margin: 0 0 8px;
    font-size: 24px;
    letter-spacing: -0.03em;
  }
  .txt p {
    margin: 0 0 18px;
    color: var(--muted);
    font-size: 15px;
  }
  .foot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    color: var(--faint);
  }
  .go {
    color: var(--acc);
    white-space: nowrap;
  }
  .note {
    margin: 18px 0 0;
    font-size: 12px;
    color: var(--faint);
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .loop {
      grid-template-columns: 1fr 1fr;
    }
    .loop li::after {
      display: none;
    }
  }
</style>
