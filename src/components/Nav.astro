---
import { nav, profile } from '../data/profile';
---

<header class="nav" transition:persist>
  <div class="container bar">
    <a href="/" class="name">{profile.name}</a>
    <nav aria-label="Sections">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="actions">
      <button class="icon" data-open-palette aria-label="Open the quick menu">
        <span class="kb mono">⌘K</span><span class="touch">Menu</span>
      </button>
      <button class="icon" data-theme-toggle aria-label="Switch between light and dark">
        <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  :global(html.scrolled) .nav {
    border-bottom-color: var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 16px;
  }
  .name {
    font-family: var(--font-serif);
    font-size: 22px;
    text-decoration: none;
  }
  ul {
    display: flex;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ul a {
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
  }
  ul a:hover,
  ul a.active {
    color: var(--text);
  }
  ul a.active {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-color: var(--accent);
  }
  .actions {
    display: flex;
    gap: 6px;
  }
  .icon {
    display: grid;
    place-items: center;
    height: 32px;
    min-width: 32px;
    padding: 0 8px;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    font: 12px var(--font-sans);
    cursor: pointer;
  }
  .icon:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }
  .touch,
  .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: none;
    }
  }
  @media (max-width: 860px) {
    nav {
      display: none;
    }
  }
  @media (pointer: coarse), (max-width: 860px) {
    .kb {
      display: none;
    }
    .touch {
      display: inline;
    }
  }
</style>
