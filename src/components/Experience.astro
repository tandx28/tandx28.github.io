---
import { experience } from '../data/profile';
---

<section id="experience">
  <div class="container">
    <div class="sec-head">
      <p class="label">Experience</p>
      <div>
        <h2 class="h2">Where I've learned.</h2>
      </div>
    </div>
    <ol class="list">
      {experience.map((j, i) => (
        <li data-reveal style={`--i:${i % 2}`}>
          <p class="when">{j.when}</p>
          <div>
            <h3>{j.what}</h3>
            <p class="where">{j.where}</p>
            <ul>{j.notes.map((n) => <li>{n}</li>)}</ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .list > li {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 24px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .when {
    margin: 0;
    font-size: 14px;
    color: var(--faint);
    padding-top: 3px;
  }
  h3 {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
  }
  .where {
    margin: 0 0 8px;
    color: var(--muted);
  }
  ul {
    margin: 0;
    padding-left: 18px;
    color: var(--muted);
    font-size: 15px;
  }
  ul li {
    margin: 4px 0;
  }
  @media (max-width: 760px) {
    .list > li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
