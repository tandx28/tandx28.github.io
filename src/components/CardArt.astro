---
// Art for a project card: the screenshot when there is one, otherwise a small
// drawn scene that hints at the work (routes for logistics, a page wireframe
// for a website, stages for a pipeline, files syncing for the vault). Drawn in SVG so it follows the theme colours.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  cover?: ImageMetadata;
}
const { id, title, cover } = Astro.props;
---

{cover ? (
  <Image src={cover} alt={`Screenshot of ${title}`} widths={[480, 800, 1200]} sizes="(max-width: 860px) 92vw, 560px" format="webp" quality={72} class="art-img" />
) : id === 'astar' ? (
  <svg viewBox="0 0 400 240" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g class="route">
      <path d="M40 200 C 90 150, 120 170, 160 120 S 240 60, 290 90 S 350 40, 370 30" />
      <path d="M30 60 C 80 80, 110 40, 170 70 S 250 180, 320 170 S 360 200, 380 210" />
    </g>
    <g class="stops">
      <circle cx="40" cy="200" r="5" /><circle cx="160" cy="120" r="5" /><circle cx="290" cy="90" r="5" /><circle cx="370" cy="30" r="5" />
      <circle cx="30" cy="60" r="5" /><circle cx="170" cy="70" r="5" /><circle cx="320" cy="170" r="5" /><circle cx="380" cy="210" r="5" />
    </g>
    <circle class="van" r="7"><animateMotion dur="7s" repeatCount="indefinite" path="M40 200 C 90 150, 120 170, 160 120 S 240 60, 290 90 S 350 40, 370 30" /></circle>
    <circle class="van b" r="7"><animateMotion dur="9s" repeatCount="indefinite" path="M30 60 C 80 80, 110 40, 170 70 S 250 180, 320 170 S 360 200, 380 210" /></circle>
  </svg>
) : id === 'story-pipeline' ? (
  <svg viewBox="0 0 400 240" preserveAspectRatio="xMidYMid slice" aria-hidden="true" class="pipe">
    <path class="belt" d="M40 120 H360" />
    {['plan', 'assets', 'voice', 'render', 'publish'].map((s, n) => (
      <g transform={`translate(${40 + n * 80} 120)`}>
        <rect x="-30" y="-22" width="60" height="44" rx="8" class="stage" style={`--d:${n * 0.6}s`} />
        <text y="5" text-anchor="middle">{s}</text>
      </g>
    ))}
    <circle r="5" class="job"><animateMotion dur="3s" repeatCount="indefinite" path="M10 120 H390" /></circle>
    <circle r="5" class="job"><animateMotion dur="3s" begin="1.5s" repeatCount="indefinite" path="M10 120 H390" /></circle>
  </svg>
) : id === 'study-vault' ? (
  <svg viewBox="0 0 400 240" preserveAspectRatio="xMidYMid slice" aria-hidden="true" class="sync">
    <g class="src"><rect x="40" y="70" width="90" height="100" rx="10" /><text x="85" y="126" text-anchor="middle">Canvas</text></g>
    <g class="dst"><rect x="270" y="70" width="90" height="100" rx="10" /><text x="315" y="126" text-anchor="middle">vault</text></g>
    <path class="lane" d="M135 105 H265" /><path class="lane" d="M135 135 H265" />
    {[0, 1, 2].map((n) => (
      <rect class="doc" width="14" height="18" rx="2" y="96" style={`--d:${n * 0.9}s`} />
    ))}
    {[0, 1].map((n) => (
      <rect class="doc b" width="14" height="18" rx="2" y="126" style={`--d:${0.45 + n * 1.35}s`} />
    ))}
    <text x="200" y="196" text-anchor="middle" class="clock">00:10 nightly</text>
  </svg>
) : (
  <svg viewBox="0 0 400 240" preserveAspectRatio="xMidYMid slice" aria-hidden="true" class="wire">
    <rect x="40" y="26" width="320" height="200" rx="10" class="frame" />
    <rect x="40" y="26" width="320" height="22" rx="10" class="bar" />
    <rect x="60" y="66" width="140" height="14" rx="4" class="hl" />
    <rect x="60" y="88" width="200" height="8" rx="4" />
    <rect x="60" y="102" width="170" height="8" rx="4" />
    <rect x="60" y="126" width="80" height="22" rx="11" class="hl btn" />
    <rect x="60" y="166" width="88" height="44" rx="6" /><rect x="156" y="166" width="88" height="44" rx="6" /><rect x="252" y="166" width="88" height="44" rx="6" />
    <rect x="252" y="66" width="88" height="82" rx="6" class="img" />
    <g class="pointer">
      <path d="M0 0 L0 17 L4.5 13 L7.5 20 L10.5 18.8 L7.6 12 L13 12 Z" />
    </g>
  </svg>
)}

<style>
  :global(.art-img),
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 1.2s var(--ease);
  }
  :global(.card:hover .art-img) {
    transform: scale(1.04);
  }
  .route path {
    fill: none;
    stroke: var(--acc);
    stroke-width: 2;
    stroke-dasharray: 6 8;
    opacity: 0.6;
    animation: dash 3s linear infinite;
  }
  .stops circle {
    fill: var(--bg);
    stroke: var(--acc);
    stroke-width: 2;
  }
  .van {
    fill: var(--acc);
    filter: drop-shadow(0 0 6px var(--acc));
  }
  .van.b {
    fill: var(--accent-2);
  }
  @keyframes dash {
    to {
      stroke-dashoffset: -28;
    }
  }
  .wire rect {
    fill: var(--line);
  }
  .wire .frame {
    fill: var(--bg);
    stroke: var(--line-strong);
  }
  .wire .bar {
    fill: var(--line-strong);
  }
  .wire .hl {
    fill: var(--acc);
    opacity: 0.8;
  }
  .wire .img {
    fill: color-mix(in srgb, var(--acc) 25%, transparent);
  }
  /* A real arrow pointer that glides from the gallery to the button and clicks it. */
  .wire .pointer path {
    fill: var(--text);
    stroke: var(--bg);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
  .wire .pointer {
    transform: translate(300px, 190px);
    animation: point 5s var(--ease) infinite;
  }
  .wire .btn {
    animation: press 5s var(--ease) infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes point {
    0%, 12% { transform: translate(300px, 190px); }
    45%, 70% { transform: translate(112px, 138px); }
    100% { transform: translate(300px, 190px); }
  }
  @keyframes press {
    0%, 52% { transform: scale(1); }
    56% { transform: scale(0.92); }
    62%, 100% { transform: scale(1); }
  }
  .pipe .belt,
  .sync .lane {
    stroke: var(--line-strong);
    stroke-width: 2;
    stroke-dasharray: 4 6;
    fill: none;
  }
  .pipe .stage {
    fill: var(--bg);
    stroke: var(--acc);
    stroke-width: 1.5;
    animation: glow 3s linear infinite;
    animation-delay: var(--d);
  }
  .pipe text,
  .sync text {
    fill: var(--muted);
    font: 11px var(--font-mono);
  }
  .pipe .job {
    fill: var(--acc);
    filter: drop-shadow(0 0 5px var(--acc));
  }
  @keyframes glow {
    0%, 100% { fill: var(--bg); }
    10% { fill: color-mix(in srgb, var(--acc) 35%, var(--bg)); }
    25% { fill: var(--bg); }
  }
  .sync rect:not(.doc) {
    fill: var(--bg);
    stroke: var(--acc);
    stroke-width: 1.5;
  }
  .sync .doc {
    fill: var(--acc);
    opacity: 0;
    animation: carry 2.7s linear infinite;
    animation-delay: var(--d);
  }
  .sync .doc.b {
    fill: var(--accent-2);
  }
  .sync .clock {
    fill: var(--faint);
  }
  @keyframes carry {
    0% { transform: translateX(140px); opacity: 0; }
    10% { opacity: 1; }
    85% { opacity: 1; }
    100% { transform: translateX(248px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wire .pointer { transform: translate(112px, 138px); }
  }
</style>
