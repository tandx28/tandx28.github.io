---
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';

// The command menu (⌘K, Ctrl+K or "/"). Items are plain links or named
// actions that src/scripts/fx.ts knows how to run.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

type Item = { group: string; label: string; hint: string; href?: string; action?: string; external?: boolean };
const items: Item[] = [
  { group: 'go to', label: 'About', hint: '#about', href: '/#about' },
  { group: 'go to', label: 'How I build with AI', hint: '#ai', href: '/#ai' },
  { group: 'go to', label: 'Work', hint: '#work', href: '/#work' },
  { group: 'go to', label: 'Journey', hint: '#journey', href: '/#journey' },
  { group: 'go to', label: 'Stack', hint: '#stack', href: '/#stack' },
  { group: 'go to', label: 'Community', hint: '#community', href: '/#community' },
  { group: 'go to', label: 'Contact', hint: '#contact', href: '/#contact' },
  ...projects
    .filter((p) => p.data.tier === 'featured')
    .map((p) => ({ group: 'projects', label: p.data.title, hint: p.data.year, href: `/projects/${p.id}/` })),
  { group: 'go to', label: 'Lab', hint: '#lab', href: '/#lab' },
  ...projects
    .filter((p) => p.data.live || p.data.play)
    .map((p) => ({ group: 'play / try', label: `Open ${p.data.title}`, hint: p.data.kind === 'film' ? 'watch ↗' : 'live ↗', href: p.data.live ?? p.data.play, external: true })),
  { group: 'links', label: 'Résumé (PDF)', hint: 'download', href: profile.resume, external: true },
  { group: 'links', label: 'GitHub', hint: '@' + profile.handle, href: profile.github, external: true },
  { group: 'links', label: 'LinkedIn', hint: 'in/dexun19', href: profile.linkedin, external: true },
  { group: 'actions', label: 'Copy email address', hint: profile.email, action: 'copy-email' },
  { group: 'actions', label: 'Toggle light / dark', hint: 'theme', action: 'theme' },
];
---

<div class="palette" data-palette hidden transition:persist>
  <div class="scrim" data-close-palette></div>
  <div class="panel" role="dialog" aria-modal="true" aria-label="Command menu">
    <div class="search">
      <span class="mono p">&gt;</span>
      <input type="text" placeholder="Type a command or search…" aria-label="Search commands" autocomplete="off" spellcheck="false" />
      <kbd class="mono">esc</kbd>
    </div>
    <ul role="listbox">
      {items.map((it) => (
        <li role="option" data-group={it.group}>
          {it.href ? (
            <a href={it.href} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener' : undefined}>
              <span class="g mono">{it.group}</span><span class="l">{it.label}</span><span class="h mono">{it.hint}</span>
            </a>
          ) : (
            <button type="button" data-action={it.action} data-email={it.action === 'copy-email' ? profile.email : undefined}>
              <span class="g mono">{it.group}</span><span class="l">{it.label}</span><span class="h mono">{it.hint}</span>
            </button>
          )}
        </li>
      ))}
    </ul>
    <p class="empty mono" hidden>No match. Try "projects" or "email".</p>
  </div>
</div>

<style>
  .palette {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: start center;
    padding: 14vh 16px 16px;
  }
  .palette[hidden] {
    display: none;
  }
  .scrim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(6px);
    animation: fade 0.25s var(--ease);
  }
  .panel {
    position: relative;
    width: min(620px, 100%);
    border-radius: 16px;
    border: 1px solid var(--line-strong);
    background: var(--surface-solid);
    box-shadow: var(--shadow);
    overflow: hidden;
    animation: pop 0.35s var(--ease);
  }
  .search {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--line);
  }
  .p {
    color: var(--accent);
  }
  input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    outline: 0;
    color: var(--text);
    font: 16px var(--font-sans);
  }
  kbd {
    font-size: 11px;
    color: var(--faint);
    border: 1px solid var(--line);
    padding: 2px 6px;
    border-radius: 5px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 8px;
    max-height: 52vh;
    overflow: auto;
  }
  li[hidden] {
    display: none;
  }
  a,
  button {
    width: 100%;
    display: grid;
    grid-template-columns: 92px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 11px 12px;
    border-radius: 10px;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 15px;
    text-align: left;
    cursor: pointer;
  }
  li.sel a,
  li.sel button {
    background: var(--bg-2);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .g {
    font-size: 11px;
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .h {
    font-size: 12px;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 180px;
  }
  .empty {
    padding: 0 20px 18px;
    margin: 0;
    color: var(--muted);
    font-size: 13px;
  }
  @media (max-width: 520px) {
    a,
    button {
      grid-template-columns: 1fr auto;
    }
    .g {
      display: none;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.98);
    }
  }
</style>
