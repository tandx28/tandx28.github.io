---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer>
  <div class="container row">
    <p>© {year} {profile.name}. Built with Astro and a lot of help from Claude Code.</p>
    <p class="hint">Press <kbd>⌘K</kbd> to jump anywhere.</p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding: 24px 0 36px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }
  p {
    margin: 0;
    font-size: 13px;
    color: var(--faint);
  }
  kbd {
    font-size: 12px;
    padding: 0 5px;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
  }
  @media (pointer: coarse) {
    .hint {
      display: none;
    }
  }
</style>
