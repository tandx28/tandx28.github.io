---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Side projects made to learn a technology by building with it. Each one is a
// single page hosted as-is under public/lab/.
const lab = (await getCollection('projects'))
  .filter((p) => p.data.tier === 'lab')
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="experiments">
  <div class="container">
    <div class="sec-head">
      <p class="label">Experiments</p>
      <div>
        <h2 class="h2">Learning by building.</h2>
        <p class="lede">
          When I want to learn something new, like 3D graphics in the browser or frame-by-frame animation, I build a
          small, finished thing with it and AI as my pair. These run right here.
        </p>
      </div>
    </div>
    <div class="grid">
      {lab.map((p, i) => (
        <a class="item" href={p.data.play} target="_blank" rel="noopener" data-reveal style={`--i:${i % 4}`}>
          <div class="shot">
            {p.data.cover && (
              <Image src={p.data.cover} alt={`Screenshot of ${p.data.title}`} widths={[400, 640]} sizes="(max-width: 860px) 46vw, 250px" format="webp" quality={70} class="shot-img" />
            )}
          </div>
          <p class="kind">{p.data.kind === 'film' ? 'Animation' : 'Browser game'} · {p.data.stack[0]}</p>
          <h3>{p.data.title} <span aria-hidden="true">↗</span></h3>
          <p class="d">{p.data.tagline}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .item {
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }
  .shot {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--bg-2);
    margin-bottom: 12px;
  }
  .shot :global(.shot-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 0.5s var(--ease);
  }
  .item:hover :global(.shot-img) {
    transform: scale(1.03);
  }
  .kind {
    margin: 0;
    font-size: 12px;
    color: var(--faint);
  }
  h3 {
    margin: 2px 0 6px;
    font-size: 17px;
    font-weight: 600;
  }
  h3 span {
    color: var(--faint);
    font-weight: 400;
  }
  .item:hover h3 {
    color: var(--accent);
  }
  .d {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
